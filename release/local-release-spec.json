{
  "format": "quexin-local-release-spec-v1",
  "target": {
    "platform": "darwin",
    "architectures": ["arm64", "x64"],
    "node": ">=22.12.0",
    "postgresqlMajor": 17
  },
  "includeFiles": [
    ".env.example",
    "README.md",
    "DEPLOY_WITH_WORKBUDDY.md",
    "本地使用说明.md",
    "index.html",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "初始化鹊信.command",
    "启动鹊信.command",
    "停止鹊信.command",
    "检查鹊信.command",
    "WorkBuddy部署检查.command",
    "config/workbuddy-options.example.json",
    "release/local-release-spec.json"
  ],
  "includeDirectories": ["src", "shared", "public", "server", "scripts", "skills"],
  "excludedPaths": [
    ".env.local",
    ".local-data",
    ".git",
    ".claude",
    ".playwright-cli",
    "node_modules",
    "dist",
    "test-results",
    "reports",
    "tests",
    ".workbuddy-options.local.json",
    "public/zhuleyi",
    "workbuddy-inbox",
    "workbuddy-archive",
    "workbuddy-exchange",
    "quexin-data"
  ],
  "excludedPrefixes": [
    "scripts/test-",
    "scripts/accept-",
    "scripts/dev-"
  ],
  "forbiddenNames": [
    "database.dump",
    "secrets.json",
    "config.json",
    "service.log",
    "postgres.log",
    "binding.json",
    "operation.lock",
    "chat.sqlite",
    "chat.sqlite-journal",
    "chat.sqlite-wal",
    "chat.sqlite-shm"
  ]
}
