{
  "name": "quexin-local-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "local:init": "node scripts/local-runtime.mjs init",
    "local:start": "node scripts/local-runtime.mjs start",
    "local:stop": "node scripts/local-runtime.mjs stop",
    "local:status": "node scripts/local-runtime.mjs status",
    "local:migrate": "node scripts/local-runtime.mjs migrate",
    "local:backup": "node scripts/local-runtime.mjs backup",
    "local:cleanup": "node scripts/local-runtime.mjs cleanup",
    "local:restore": "node scripts/local-runtime.mjs restore",
    "local:doctor": "node scripts/production-doctor.mjs --local",
    "production:doctor": "node scripts/production-doctor.mjs",
    "workbuddy:check": "node scripts/workbuddy-preflight.mjs",
    "workbuddy:deploy": "node scripts/workbuddy-deploy.mjs",
    "workbuddy:config": "node scripts/workbuddy-config.mjs",
    "workbuddy:lifecycle": "node scripts/workbuddy-lifecycle.mjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node server/mock-server.mjs --port 4191",
    "dev:api:formal": "node server/prod-server.mjs --memory --port 4193",
    "dev:api:postgres-local": "env DATABASE_URL=postgres://quexin_app_test@127.0.0.1:5432/quexin_test PUBLIC_ORIGIN=http://127.0.0.1:4188 DEV_MAILBOX=true NOTIFICATION_ENCRYPTION_KEY=quexin-local-dev-only node server/prod-server.mjs --port 4193",
    "start:api": "node server/prod-server.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:formal-full": "node scripts/dev-formal-full.mjs",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "test:mock-cloud": "node scripts/test-mock-cloud.mjs",
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:api:postgres": "playwright test --config playwright.postgres.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:account": "playwright test --config playwright.account.config.ts",
    "test:couple": "playwright test --config playwright.couple.config.ts",
    "test:import": "playwright test --config playwright.import.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "test:privacy": "playwright test --config playwright.privacy.config.ts",
    "test:lifecycle": "playwright test --config playwright.lifecycle.config.ts",
    "test:lifecycle-store": "node --test tests/lifecycle-store.test.mjs",
    "test:care-store": "node --test tests/care-store.test.mjs",
    "test:capsule-store": "node --test tests/capsule-store.test.mjs",
    "test:creation": "playwright test --config playwright.creation.config.ts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:reminders": "node --test tests/reminders.test.mjs",
    "test:care": "playwright test --config playwright.care.config.ts",
    "test:ai": "playwright test --config playwright.ai.config.ts",
    "test:local-runtime": "node scripts/test-local-runtime.mjs",
    "test:full": "node scripts/test-full.mjs",
    "test:fresh-install": "node scripts/test-fresh-install.mjs",
    "test:companion-store": "node --test tests/companion-store.test.mjs",
    "test:account-tokens": "node --test tests/account-tokens.test.mjs",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts",
    "test:maintenance": "env MAINTENANCE_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test node scripts/test-maintenance.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:start": "/opt/homebrew/opt/postgresql@17/bin/pg_ctl -D /opt/homebrew/var/postgresql@17 -l .local-data/postgresql.log start",
    "db:stop": "/opt/homebrew/opt/postgresql@17/bin/pg_ctl -D /opt/homebrew/var/postgresql@17 stop",
    "maintenance:once": "env MAINTENANCE_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test node server/maintenance.mjs --once",
    "maintenance:local": "env MAINTENANCE_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test node server/maintenance.mjs",
    "notification:once": "env NOTIFICATION_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test NOTIFICATION_ENCRYPTION_KEY=quexin-local-dev-only node server/notification-worker.mjs --once",
    "notification:local": "env NOTIFICATION_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test NOTIFICATION_ENCRYPTION_KEY=quexin-local-dev-only node server/notification-worker.mjs",
    "notification:test-json": "env NOTIFICATION_DATABASE_URL=postgres://127.0.0.1:5432/quexin_test NOTIFICATION_ENCRYPTION_KEY=quexin-local-dev-only NOTIFICATION_DRIVER=json NOTIFICATION_OUTBOX=.local-data/notification-json node server/notification-worker.mjs --once",
    "test:notification": "node scripts/test-notification.mjs",
    "test:runtime-config": "node --test tests/runtime-config.test.mjs",
    "test:operations-permissions": "node scripts/test-operations-permissions.mjs",
    "test:workbuddy-preflight": "node --test tests/workbuddy-preflight.test.mjs",
    "test:workbuddy-deploy": "node --test tests/workbuddy-deploy.test.mjs",
    "test:workbuddy-options": "node --test tests/workbuddy-options.test.mjs",
    "test:assistant-admin-config": "node --test tests/assistant-admin-config.test.mjs",
    "test:qingniao-skill": "node --test tests/qingniao-skill-package.test.mjs",
    "test:workbuddy-config": "node --test tests/workbuddy-config.test.mjs",
    "test:workbuddy-lifecycle": "node --test tests/workbuddy-lifecycle.test.mjs",
    "test:final-local-release": "node scripts/test-final-local-release.mjs",
    "test:release-bundle": "node --test tests/release-bundle.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:mobile": "env DISABLE_API_PROXY=true vite preview --host 0.0.0.0 --port 4189 --strictPort"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.5",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.14.0",
    "zod": "^4.6.7"
  }
}
