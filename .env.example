# 正式 API
DATABASE_URL=postgres://quexin_app:change-me@127.0.0.1:5432/quexin
# 维护进程需要能跨 RLS 清理到期任务，应使用独立维护/迁移角色，不能暴露给浏览器。
MAINTENANCE_DATABASE_URL=postgres://quexin_maintenance:change-me@127.0.0.1:5432/quexin
MAINTENANCE_INTERVAL_MS=60000
NOTIFICATION_DATABASE_URL=postgres://quexin_notification:change-me@127.0.0.1:5432/quexin
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
CAPSULE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
NOTIFICATION_DRIVER=smtp
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=鹊信 <no-reply@example.com>
NOTIFICATION_INTERVAL_MS=15000
NOTIFICATION_LEASE_MS=300000
SMTP_VERIFY_ON_START=true
# 通知与胶囊密钥都至少 32 个随机字符；生产应分别生成，且不要与数据库密码复用。
PUBLIC_ORIGIN=https://quexin.example.com
HOST=127.0.0.1
PORT=4193
PG_POOL_MAX=5

# 可选：真实青鸟助手。复制到 .env.local 后填写；该文件已被 gitignore。
# OpenAI Responses API 默认地址为 https://api.openai.com/v1，也可指向兼容的服务端代理。
ASSISTANT_PROVIDER=openai-compatible
ASSISTANT_API_URL=https://api.openai.com/v1
ASSISTANT_API_KEY=replace-with-server-side-key
ASSISTANT_MODEL=replace-with-an-available-structured-output-model
ASSISTANT_TRANSCRIPTION_MODEL=gpt-transcribe
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_MAX_SOURCES=6
ASSISTANT_MAX_SOURCE_CHARS=1800

# 浏览器端只使用相对路径，不应暴露数据库密码或对象存储密钥。
